# Copy this file to .env for local containers. Blank credential values must be
# supplied locally and must never be committed.
APP_ENV=development
LOG_LEVEL=INFO
DEV_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=ai_website_generator
POSTGRES_USER=ai_website_generator
POSTGRES_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
QDRANT_URL=http://127.0.0.1:6333
QDRANT_HTTP_PORT=6333
QDRANT_API_KEY=
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_PORT=11434
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_GENERATION_MODEL=qwen3-coder:30b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_CPU_LIMIT=8.0
OLLAMA_MEMORY_LIMIT=16g
OLLAMA_GPU_COUNT=1
OLLAMA_GPU_CPU_LIMIT=8.0
OLLAMA_GPU_MEMORY_LIMIT=24g
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
FIXTURE_WEBSITE_PORT=8088
