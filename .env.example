# Copy this file to .env for local containers. Blank credential values must be
# supplied locally and must never be committed.
APP_ENV=development
LOG_LEVEL=INFO
DEV_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=ai_website_generator
POSTGRES_USER=ai_website_generator
POSTGRES_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PROVIDER=minio
MINIO_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SESSION_TOKEN=
MINIO_READ_TIMEOUT_SECONDS=60
MINIO_MULTIPART_PART_SIZE=8388608
QDRANT_URL=http://127.0.0.1:6333
QDRANT_HTTP_PORT=6333
QDRANT_API_KEY=
QDRANT_CONNECT_TIMEOUT_SECONDS=5
QDRANT_REQUEST_TIMEOUT_SECONDS=30
QDRANT_MAX_CONCURRENCY=8
QDRANT_MAX_BATCH_SIZE=256
QDRANT_COLLECTION_ALIAS=design-patterns
QDRANT_VECTOR_NAME=design-pattern
QDRANT_SERIALIZATION_SCHEMA_VERSION=1
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
# Optional explicit Temporal test-server binary. Leave blank to keep offline tests skipped.
TEMPORAL_TEST_SERVER_PATH=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_PORT=11434
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_GENERATION_MODEL=qwen3-coder:30b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
OLLAMA_CONCURRENCY_WAIT_SECONDS=10
OLLAMA_MAX_CONCURRENCY=2
OLLAMA_MAX_ATTEMPTS=3
OLLAMA_RETRY_BACKOFF_SECONDS=0.25
OLLAMA_CIRCUIT_FAILURE_THRESHOLD=3
OLLAMA_CIRCUIT_RECOVERY_SECONDS=30
OLLAMA_METADATA_CACHE_SECONDS=30
OLLAMA_MAX_PROMPT_BYTES=262144
OLLAMA_MAX_IMAGE_BYTES=10485760
OLLAMA_MAX_TOTAL_IMAGE_BYTES=20971520
OLLAMA_MAX_RESPONSE_BYTES=4194304
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_CPU_LIMIT=8.0
OLLAMA_MEMORY_LIMIT=16g
OLLAMA_GPU_COUNT=1
OLLAMA_GPU_CPU_LIMIT=8.0
OLLAMA_GPU_MEMORY_LIMIT=24g
AI_WORKER_MAX_CONCURRENT_ACTIVITIES=2
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
FIXTURE_WEBSITE_PORT=8088
SECURITY_ADMINISTRATOR_EMAILS=[]
# Crawler identity and bounded robots.txt retrieval (operator-controlled defaults)
SCANNING_CRAWLER_USER_AGENT=AIWebsiteGeneratorBot/1.0
SCANNING_ROBOTS_MAX_BYTES=524288
