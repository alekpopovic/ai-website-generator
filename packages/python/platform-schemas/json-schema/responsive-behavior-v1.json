{
  "$defs": {
    "ComponentName": {
      "description": "Controlled abstract component vocabulary; never executable component source.",
      "enum": [
        "nav-link",
        "heading",
        "body-copy",
        "button",
        "badge",
        "card",
        "statistic",
        "feature-item",
        "service-item",
        "media-placeholder",
        "gallery-grid",
        "testimonial-card",
        "case-study-card",
        "pricing-tier",
        "comparison-table",
        "accordion",
        "contact-form",
        "link-list",
        "unknown"
      ],
      "title": "ComponentName",
      "type": "string"
    }
  },
  "$id": "https://schemas.ai-website-generator.local/analysis/v1/responsive-behavior.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Observed layout changes across bounded viewport ranges.",
  "properties": {
    "affected_components": {
      "default": [],
      "description": "Controlled components affected by the change.",
      "items": {
        "$ref": "#/$defs/ComponentName"
      },
      "maxItems": 24,
      "title": "Affected Components",
      "type": "array"
    },
    "behavior": {
      "description": "Controlled responsive transformation category.",
      "enum": [
        "stack-columns",
        "collapse-navigation",
        "wrap-items",
        "reduce-spacing",
        "resize-type",
        "hide-secondary-content",
        "preserve-layout",
        "unknown"
      ],
      "title": "Behavior",
      "type": "string"
    },
    "maximum_width_px": {
      "description": "Inclusive upper viewport width for this behavior.",
      "maximum": 7680,
      "minimum": 240,
      "title": "Maximum Width Px",
      "type": "integer"
    },
    "minimum_width_px": {
      "description": "Inclusive lower viewport width for this behavior.",
      "maximum": 7680,
      "minimum": 240,
      "title": "Minimum Width Px",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "description": "Normalized analysis schema version.",
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "minimum_width_px",
    "maximum_width_px",
    "behavior"
  ],
  "title": "ResponsiveBehavior",
  "type": "object"
}
