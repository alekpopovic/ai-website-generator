{
  "$defs": {
    "ComponentName": {
      "description": "Controlled abstract component vocabulary; never executable component source.",
      "enum": [
        "nav-link",
        "heading",
        "body-copy",
        "button",
        "badge",
        "card",
        "statistic",
        "feature-item",
        "service-item",
        "media-placeholder",
        "gallery-grid",
        "testimonial-card",
        "case-study-card",
        "pricing-tier",
        "comparison-table",
        "accordion",
        "contact-form",
        "link-list",
        "unknown"
      ],
      "title": "ComponentName",
      "type": "string"
    },
    "CopyPurpose": {
      "description": "Abstract communication goal used instead of source website text.",
      "enum": [
        "identity",
        "navigation",
        "value-proposition",
        "build-trust",
        "explain-benefits",
        "describe-services",
        "quantify-outcomes",
        "editorial-content",
        "showcase-work",
        "social-proof",
        "compare-options",
        "answer-objections",
        "conversion",
        "contact",
        "legal-navigation",
        "unknown"
      ],
      "title": "CopyPurpose",
      "type": "string"
    }
  },
  "$id": "https://schemas.ai-website-generator.local/analysis/v1/component-pattern.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Abstract registered component occurrence, never source code or executable markup.",
  "properties": {
    "component_name": {
      "$ref": "#/$defs/ComponentName",
      "description": "Controlled component registry name."
    },
    "copy_purpose": {
      "$ref": "#/$defs/CopyPurpose",
      "description": "Communication purpose instead of source copy."
    },
    "layout": {
      "default": "unknown",
      "description": "Controlled abstract layout mode.",
      "enum": [
        "block",
        "inline",
        "flex-row",
        "flex-column",
        "grid",
        "overlay",
        "unknown"
      ],
      "title": "Layout",
      "type": "string"
    },
    "order": {
      "description": "Zero-based order within its parent section.",
      "maximum": 255,
      "minimum": 0,
      "title": "Order",
      "type": "integer"
    },
    "repeat_count": {
      "default": 1,
      "description": "Observed bounded repetition count.",
      "maximum": 100,
      "minimum": 1,
      "title": "Repeat Count",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "description": "Normalized analysis schema version.",
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "component_name",
    "order",
    "copy_purpose"
  ],
  "title": "ComponentPattern",
  "type": "object"
}
