{
  "components": {
    "schemas": {
      "ApiResponse_VersionInfo_": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/VersionInfo"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        },
        "required": [
          "data"
        ],
        "title": "ApiResponse[VersionInfo]",
        "type": "object"
      },
      "DependencyCheck": {
        "additionalProperties": false,
        "description": "Sanitized result of one bounded dependency probe.",
        "properties": {
          "critical": {
            "title": "Critical",
            "type": "boolean"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "latency_ms": {
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/DependencyState"
          }
        },
        "required": [
          "name",
          "state",
          "critical",
          "latency_ms"
        ],
        "title": "DependencyCheck",
        "type": "object"
      },
      "DependencyHealthResponse": {
        "additionalProperties": false,
        "description": "Aggregate dependency health response.",
        "properties": {
          "dependencies": {
            "items": {
              "$ref": "#/components/schemas/DependencyCheck"
            },
            "title": "Dependencies",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/HealthState"
          }
        },
        "required": [
          "status",
          "dependencies"
        ],
        "title": "DependencyHealthResponse",
        "type": "object"
      },
      "DependencyState": {
        "description": "Public state vocabulary used by dependency health endpoints.",
        "enum": [
          "available",
          "unavailable"
        ],
        "title": "DependencyState",
        "type": "string"
      },
      "HealthState": {
        "description": "Aggregate health vocabulary.",
        "enum": [
          "healthy",
          "degraded",
          "not_ready"
        ],
        "title": "HealthState",
        "type": "string"
      },
      "InvalidParameter": {
        "additionalProperties": false,
        "description": "Sanitized request-validation failure detail.",
        "properties": {
          "location": {
            "title": "Location",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "name",
          "location",
          "reason"
        ],
        "title": "InvalidParameter",
        "type": "object"
      },
      "LivenessResponse": {
        "additionalProperties": false,
        "description": "Process liveness response without external I/O.",
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/HealthState"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "PaginationMeta": {
        "additionalProperties": false,
        "description": "Stable pagination metadata independent of domain resources.",
        "properties": {
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "limit": {
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "minimum": 0,
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "offset",
          "limit",
          "total",
          "has_more"
        ],
        "title": "PaginationMeta",
        "type": "object"
      },
      "PaginationParams": {
        "additionalProperties": false,
        "description": "Validated offset pagination query values.",
        "properties": {
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          }
        },
        "title": "PaginationParams",
        "type": "object"
      },
      "ProblemDetail": {
        "$defs": {
          "InvalidParameter": {
            "additionalProperties": false,
            "description": "Sanitized request-validation failure detail.",
            "properties": {
              "location": {
                "title": "Location",
                "type": "string"
              },
              "name": {
                "title": "Name",
                "type": "string"
              },
              "reason": {
                "title": "Reason",
                "type": "string"
              }
            },
            "required": [
              "name",
              "location",
              "reason"
            ],
            "title": "InvalidParameter",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "Problem Details response compatible with RFC 7807 and RFC 9457 clients.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "extensions": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Extensions"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instance"
          },
          "invalid_parameters": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/InvalidParameter"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Invalid Parameters"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "anyOf": [
              {
                "format": "uri",
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "default": "about:blank",
            "title": "Type"
          }
        },
        "required": [
          "title",
          "status",
          "code",
          "request_id"
        ],
        "title": "ProblemDetail",
        "type": "object"
      },
      "ResponseMeta": {
        "additionalProperties": false,
        "description": "Metadata common to envelope responses.",
        "properties": {
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "title": "ResponseMeta",
        "type": "object"
      },
      "VersionInfo": {
        "additionalProperties": false,
        "description": "Public API and service version information.",
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "service_version": {
            "title": "Service Version",
            "type": "string"
          }
        },
        "required": [
          "api_version",
          "service_version",
          "environment"
        ],
        "title": "VersionInfo",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "AI Website Generator API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/version": {
      "get": {
        "description": "Return the stable API contract version and current service build version.",
        "operationId": "getApiVersion",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_VersionInfo_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Forbidden"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Version",
        "tags": [
          "system"
        ]
      }
    },
    "/health/dependencies": {
      "get": {
        "description": "Report all direct and worker-facing infrastructure dependency checks.",
        "operationId": "getDependencyHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DependencyHealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DependencyHealthResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Dependencies",
        "tags": [
          "health"
        ]
      }
    },
    "/health/live": {
      "get": {
        "description": "Report whether the request process can serve HTTP.",
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Report readiness of dependencies required by the control plane.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DependencyHealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DependencyHealthResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    }
  }
}
