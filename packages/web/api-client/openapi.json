{
  "components": {
    "schemas": {
      "AccessTokenResponse": {
        "additionalProperties": false,
        "description": "Short-lived access token plus current-user state.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "exclusiveMinimum": 0.0,
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": [
          "access_token",
          "expires_in",
          "user"
        ],
        "title": "AccessTokenResponse",
        "type": "object"
      },
      "ApiResponse_VersionInfo_": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/VersionInfo"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        },
        "required": [
          "data"
        ],
        "title": "ApiResponse[VersionInfo]",
        "type": "object"
      },
      "DependencyCheck": {
        "additionalProperties": false,
        "description": "Sanitized result of one bounded dependency probe.",
        "properties": {
          "critical": {
            "title": "Critical",
            "type": "boolean"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "latency_ms": {
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/DependencyState"
          }
        },
        "required": [
          "name",
          "state",
          "critical",
          "latency_ms"
        ],
        "title": "DependencyCheck",
        "type": "object"
      },
      "DependencyHealthResponse": {
        "additionalProperties": false,
        "description": "Aggregate dependency health response.",
        "properties": {
          "dependencies": {
            "items": {
              "$ref": "#/components/schemas/DependencyCheck"
            },
            "title": "Dependencies",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/HealthState"
          }
        },
        "required": [
          "status",
          "dependencies"
        ],
        "title": "DependencyHealthResponse",
        "type": "object"
      },
      "DependencyState": {
        "description": "Public state vocabulary used by dependency health endpoints.",
        "enum": [
          "available",
          "unavailable"
        ],
        "title": "DependencyState",
        "type": "string"
      },
      "HealthState": {
        "description": "Aggregate health vocabulary.",
        "enum": [
          "healthy",
          "degraded",
          "not_ready"
        ],
        "title": "HealthState",
        "type": "string"
      },
      "InvalidParameter": {
        "additionalProperties": false,
        "description": "Sanitized request-validation failure detail.",
        "properties": {
          "location": {
            "title": "Location",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "name",
          "location",
          "reason"
        ],
        "title": "InvalidParameter",
        "type": "object"
      },
      "LivenessResponse": {
        "additionalProperties": false,
        "description": "Process liveness response without external I/O.",
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/HealthState"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "Email and password login payload.",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MessageResponse": {
        "additionalProperties": false,
        "description": "Non-enumerating acknowledgement.",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "MessageResponse",
        "type": "object"
      },
      "PaginationMeta": {
        "additionalProperties": false,
        "description": "Stable pagination metadata independent of domain resources.",
        "properties": {
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "limit": {
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "minimum": 0,
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "offset",
          "limit",
          "total",
          "has_more"
        ],
        "title": "PaginationMeta",
        "type": "object"
      },
      "PaginationParams": {
        "additionalProperties": false,
        "description": "Validated offset pagination query values.",
        "properties": {
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          }
        },
        "title": "PaginationParams",
        "type": "object"
      },
      "PasswordResetRequest": {
        "additionalProperties": false,
        "description": "Enumeration-resistant reset email request.",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "PasswordResetRequest",
        "type": "object"
      },
      "ProblemDetail": {
        "$defs": {
          "InvalidParameter": {
            "additionalProperties": false,
            "description": "Sanitized request-validation failure detail.",
            "properties": {
              "location": {
                "title": "Location",
                "type": "string"
              },
              "name": {
                "title": "Name",
                "type": "string"
              },
              "reason": {
                "title": "Reason",
                "type": "string"
              }
            },
            "required": [
              "name",
              "location",
              "reason"
            ],
            "title": "InvalidParameter",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "Problem Details response compatible with RFC 7807 and RFC 9457 clients.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "extensions": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Extensions"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instance"
          },
          "invalid_parameters": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/InvalidParameter"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Invalid Parameters"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "anyOf": [
              {
                "format": "uri",
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "default": "about:blank",
            "title": "Type"
          }
        },
        "required": [
          "title",
          "status",
          "code",
          "request_id"
        ],
        "title": "ProblemDetail",
        "type": "object"
      },
      "RegisterRequest": {
        "additionalProperties": false,
        "description": "New user registration payload.",
        "properties": {
          "display_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 12,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "display_name",
          "password"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "ResetPasswordRequest": {
        "additionalProperties": false,
