{
  "name": "ai-website-generator",
  "version": "0.0.0",
  "private": true,
  "description": "Development tooling for the AI website generation monorepo",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0 <27",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "typecheck": "pnpm --recursive --if-present --filter './apps/**' --filter './packages/**' run typecheck",
    "unit-test": "pnpm --recursive --if-present --filter './apps/**' --filter './packages/**' run unit-test",
    "integration-test": "pnpm --recursive --if-present --filter './apps/**' --filter './packages/**' run integration-test",
    "e2e-test": "pnpm --recursive --if-present --filter './apps/**' --filter './packages/**' run e2e-test",
    "generate-api-client": "pnpm --filter '@platform/api-client' --if-present run generate",
    "audit": "pnpm audit --audit-level moderate",
    "licenses": "pnpm licenses list --long",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.1",
    "@eslint/markdown": "8.0.3",
    "angular-eslint": "22.1.0",
    "eslint": "10.8.0",
    "eslint-plugin-yml": "3.6.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0"
  }
}
