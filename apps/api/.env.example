# FastAPI development defaults. Supply credentials in apps/api/.env or through
# the local secret mechanism; never commit populated values.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
APP_NAME=AI Website Generator API
APP_VERSION=0.0.0
APP_DEBUG=false
APP_FAKE_DEPENDENCIES=false
APP_CORS_ALLOWED_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_COMMAND_TIMEOUT_SECONDS=30
DATABASE_ECHO=false
# Tests accept only an explicitly disposable PostgreSQL database ending in `_test`.
INTEGRATION_DATABASE_URL=
INTEGRATION_DATABASE_RESET_ALLOWED=false
REDIS_URL=
REDIS_KEY_PREFIX=aiwg
REDIS_CONNECT_TIMEOUT_SECONDS=3
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=control-plane
TEMPORAL_CONNECT_TIMEOUT_SECONDS=5
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PROVIDER=minio
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SESSION_TOKEN=
MINIO_SECURE=false
MINIO_CONNECT_TIMEOUT_SECONDS=5
MINIO_READ_TIMEOUT_SECONDS=60
MINIO_MULTIPART_PART_SIZE=8388608
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_GENERATION_MODEL=qwen3-coder:30b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
SECURITY_TRUSTED_HOSTS=["localhost","127.0.0.1"]
SECURITY_FORCE_HTTPS=false
SECURITY_ENABLE_DOCS=true
SECURITY_REQUEST_ID_HEADER=X-Request-ID
SECURITY_MAX_REQUEST_BODY_BYTES=1048576
SECURITY_ACCESS_TOKEN_SECRET=
SECURITY_ACCESS_TOKEN_ISSUER=ai-website-generator
SECURITY_ACCESS_TOKEN_AUDIENCE=ai-website-generator-web
SECURITY_ACCESS_TOKEN_TTL_SECONDS=300
SECURITY_REFRESH_TOKEN_TTL_SECONDS=2592000
SECURITY_REFRESH_COOKIE_NAME=aiwg_refresh
SECURITY_REFRESH_COOKIE_DOMAIN=
SECURITY_REFRESH_COOKIE_SECURE=false
SECURITY_REFRESH_COOKIE_SAMESITE=lax
SECURITY_LOGIN_RATE_LIMIT_ATTEMPTS=5
SECURITY_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
SECURITY_EMAIL_VERIFICATION_TTL_SECONDS=86400
SECURITY_PASSWORD_RESET_TTL_SECONDS=1800
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_START_TLS=false
EMAIL_SMTP_USE_TLS=false
EMAIL_SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM_ADDRESS=no-reply@local.test
EMAIL_PUBLIC_WEB_URL=http://localhost:4200
SCANNING_MAX_PAGES_PER_SCAN=100
SCANNING_MAX_DEPTH=5
SCANNING_REQUESTS_PER_SECOND=1.0
SCANNING_WORKFLOW_TIMEOUT_SECONDS=7200
GENERATION_MAX_PAGES_PER_SITE=50
GENERATION_MAX_REPAIR_ATTEMPTS=3
GENERATION_WORKFLOW_TIMEOUT_SECONDS=3600
