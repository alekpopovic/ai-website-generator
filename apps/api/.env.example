# FastAPI development defaults. Supply credentials in apps/api/.env or through
# the local secret mechanism; never commit populated values.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0
TEMPORAL_ADDRESS=127.0.0.1:7233
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
QDRANT_URL=http://127.0.0.1:6333
